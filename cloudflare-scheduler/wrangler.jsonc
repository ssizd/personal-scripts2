{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "discord-notifier-scheduler",
  "main": "src/index.js",
  "compatibility_date": "2026-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "triggers": {
    "crons": [
      "5,20,35,50 0-14 * * *",
      "5,20,35,50 23 * * *"
    ]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    }
  }
}
